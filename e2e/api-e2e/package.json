{
  "name": "@fms/api-e2e",
  "version": "0.0.1",
  "private": true,
  "description": "Java api 를 URL 로만 호출하는 블랙박스 계약 테스트. 원본(Express) api e2e 를 그대로 옮겨 왔다.",
  "scripts": {
    "type:check": "tsc --noEmit",
    "lint:check": "biome check",
    "lint:format": "biome check --write",
    "e2e": "node --env-file-if-exists=../../.env.local ../../node_modules/jest/bin/jest.js --config ./jest.config.cjs --runInBand"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@fms/biome-config": "workspace:^",
    "@fms/types": "workspace:^",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "pg": "8.23.1",
    "supertest": "7.3.1",
    "typescript": "7.0.2"
  }
}
