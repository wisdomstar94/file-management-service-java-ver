{
  "name": "@fms/consts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "build": "EMPTY_OUT_DIR=true vite build",
    "watch": "vite build --watch",
    "type:check": "tsc --noEmit",
    "lint:check": "biome check",
    "lint:format": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@fms/biome-config": "workspace:^",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "exports": {
    "./permissions/*": {
      "require": {
        "types": "./dist/permissions/*/index.d.ts",
        "default": "./dist/permissions/*/index.cjs"
      },
      "import": {
        "types": "./dist/permissions/*/index.d.ts",
        "default": "./dist/permissions/*/index.mjs"
      }
    },
    "./errors/*": {
      "require": {
        "types": "./dist/errors/*/index.d.ts",
        "default": "./dist/errors/*/index.cjs"
      },
      "import": {
        "types": "./dist/errors/*/index.d.ts",
        "default": "./dist/errors/*/index.mjs"
      }
    },
    "./access-policies/*": {
      "require": {
        "types": "./dist/access-policies/*/index.d.ts",
        "default": "./dist/access-policies/*/index.cjs"
      },
      "import": {
        "types": "./dist/access-policies/*/index.d.ts",
        "default": "./dist/access-policies/*/index.mjs"
      }
    },
    "./cookies/*": {
      "require": {
        "types": "./dist/cookies/*/index.d.ts",
        "default": "./dist/cookies/*/index.cjs"
      },
      "import": {
        "types": "./dist/cookies/*/index.d.ts",
        "default": "./dist/cookies/*/index.mjs"
      }
    },
    "./jwt/*": {
      "require": {
        "types": "./dist/jwt/*/index.d.ts",
        "default": "./dist/jwt/*/index.cjs"
      },
      "import": {
        "types": "./dist/jwt/*/index.d.ts",
        "default": "./dist/jwt/*/index.mjs"
      }
    }
  }
}
